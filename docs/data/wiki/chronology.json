    {
      "id": "worldchronology-0",
      "title": "세계 연대기",
      "items": [
        {
          "title": "3부 · 세계시간상 1부 이전",
          "description": "신수 데미우르고스가 아직 신위를 얻지 않은 인간 자신을 이 시대에 옮겨놓은 뒤 떠난다. 이후 2부 이후의 카르가 시간 신위를 지닌 채 도착하고 3부 주인공의 토벌 서사가 진행된다.",
          "status": "현재 구상"
        },
        {
          "title": "우르의 시간 신위 획득",
          "description": "카르의 신위가 토벌 뒤 분리될 때 우르가 시간 신위를 이어받는 안. 이후 자기 인과의 폐쇄성과 육환신수의 제약을 인식한다.",
          "status": "유력 구상"
        },
        {
          "title": "패러독스 실험과 신수전쟁",
          "description": "신위에 오른 데미우르고스는 미래를 부정하는 실험을 반복하다 상호 제약을 발견하고, 이를 깨려는 시도가 육환신수 간 전쟁으로 확대된다. 이 시대의 말과 전쟁 흔적이 후대에 전승된다.",
          "status": "현재 설정"
        },
        {
          "title": "전후 이상낙원 계획",
          "description": "전쟁 뒤 데미우르고스는 카르 신격화의 진의를 숨기고 이상낙원을 제안한다. 육환신수의 공동 참여로 엘로이 문명의 장기 배양 기반이 마련된다.",
          "status": "현재 설정"
        },
        {
          "title": "1부 · 현대",
          "description": "데미우르고스의 절망에서 나온 격언은 출처가 희석되어 오래된 속담처럼 퍼져 있고, 엘린도 이를 희망적인 뜻으로 사용할 수 있다. 1부 말 데미우르고스의 손이 카르를 엘로이 시대 말미로 끌어간다.",
          "status": "현재 설정"
        },
        {
          "title": "엘로이 문명 · 약 200만 년",
          "description": "육환신수의 이상낙원은 실제로 장기간 안정적으로 운영된다. 그동안 문명 전체가 데미우르고스가 숨긴 통합 신위 배양판의 역할도 동시에 수행한다.",
          "status": "현재 설정"
        },
        {
          "title": "2부 · 엘로이 시대 말미",
          "description": "카르가 도착해 엘린과 재회하고 데미우르고스를 토벌·흡수해 시간 신위를 얻는다. 문명은 종말을 맞고 카르는 여러 신위와 문명의 마력원을 수렴해 신격화된 뒤 세계시간상 과거의 3부 시대로 향한다.",
          "status": "현재 구상"
        }
      ]
    }
  ],
