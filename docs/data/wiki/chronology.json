    {
      "id": "worldchronology-0",
      "title": "세계 연대기 · 실제 발생 순서",
      "items": [
        {
          "title": "3부 · 인간 우르 유입",
          "description": "데미우르고스가 신위 획득 전의 자기 자신을 1부보다 이른 시대에 옮긴다.",
          "status": "현재 구상"
        },
        {
          "title": "3부 · 신격 카르와 신역",
          "description": "2부에서 신격화한 카르가 3부의 과거에 도착해 신역을 만들고 의식을 분리한다.",
          "status": "현재 구상"
        },
        {
          "title": "3부 · 용사의 첫 대면",
          "description": "용사 일행이 신역에서 정신과 존재를 침해당한 뒤 '다시 돌아와'라는 말을 듣는다.",
          "status": "첫 대면 구상"
        },
        {
          "title": "3부 · 마왕의 패배",
          "description": "마왕 카르는 신역을 지키기 위해 전력을 다해 저항하다 패배한다. 신역 붕괴가 시작된다.",
          "status": "최종전 구상"
        },
        {
          "title": "3부 · 인간 카르의 마지막 결투",
          "description": "신역 내부의 카르는 보드게임을 마무리하고 용사들에게 사과와 해후를 전한 뒤 친구들을 지키기 위해 마력검 결투를 제안한다.",
          "status": "3페이즈 구상"
        },
        {
          "title": "3부 종막 · 회로의 확산과 계승",
          "description": "신위가 분리되고 우르가 시간 신위를 계승한다. 통합 회로가 세계로 퍼져 현대 마법의 기원이 되는 안이며 카르와 주민들의 최후는 일부 미정이다.",
          "status": "유력 구상 · 기전 미정"
        },
        {
          "title": "신수전쟁과 엘로이의 설계",
          "description": "우르가 데미우르고스가 되어 미래 반증을 시도하다 전쟁을 벌이고, 전후 엘로이 문명의 오랜 배양 계획을 마련한다.",
          "status": "현재 설정"
        },
        {
          "title": "1부 · 어린 카르와 엘린",
          "description": "미래에서 온 엘린이 어린 카르에게 회로를 남기고 사고로 죽는다.",
          "status": "현재 설정"
        },
        {
          "title": "1부 · 이음새와 개별 사건",
          "description": "카르의 합류부터 에테아·모르시아의 기억 사건, 프레미아 계승, 유마·칸하, 연구소의 완성작과 토마·테라로 이어진다.",
          "status": "현재 구상"
        },
        {
          "title": "1부 · 희생과 종장",
          "description": "유마의 희생, 니벨의 이탈, 남은 일상, 삼파전과 거대한 손, 카르의 미래 전이, 에테아의 제4의 답이 진행된다.",
          "status": "현재 구상"
        },
        {
          "title": "엘로이 문명 · 약 200만 년",
          "description": "이상낙원은 실제로 장기간 존속하고 마력·순수 회로의 기반이 된다.",
          "status": "현재 설정"
        },
        {
          "title": "2부 · 카르의 신격화",
          "description": "엘로이 재회, 데미우르고스 토벌과 시간 신위, 문명 종말, 엘린 과거행, 회로 합일을 거쳐 카르가 3부 과거로 향한다.",
          "status": "현재 구상"
        }
      ]
    },
    {
      "id": "personal-order",
      "title": "인물별 개인 시간의 순서",
      "items": [
        {
          "title": "카르",
          "description": "1부 유년과 이음새 → 2부 미래의 엘로이 문명과 통합 신격화 → 3부 과거의 신역·마왕 패배·인간 카르 결투. 현대 귀환은 결말 후보이므로 확정 연표에 포함하지 않는다.",
          "status": "개인 시간"
        },
        {
          "title": "우르 / 데미우르고스",
          "description": "인간 우르가 과거 3부로 옮겨짐 → 토벌대 동행 → 시간 신위 계승 → 자기반증과 신수전쟁 → 낙원 설계 → 자신의 인간 시절을 과거로 보냄 → 1부 카르 전이 → 2부 흡수.",
          "status": "개인 시간"
        },
        {
          "title": "엘린",
          "description": "엘로이 시대에 카르와 재회 → 과거로 이동 → 현대에서 어린 카르와 함께 지냄 → 사고와 회로 전달. 작품 1부의 프롤로그가 엘린 개인에게는 마지막 시기다.",
          "status": "개인 시간"
        }
      ]
    }
  ],
